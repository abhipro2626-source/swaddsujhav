# Copy to backend/.env  (this file is git-ignored; never ship it to the browser)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Lets the ML job read all orders and write recommendation tables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Paaji's studio voice (ElevenLabs). Leave empty to use the free browser voice.
# Lines are cached in backend/.cache/tts so each line is generated (and billed) once.
ELEVENLABS_API_KEY=
# A deep male voice ID from your ElevenLabs Voice Library (default: "Adam").
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional
PORT=8130
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRAIN_EVERY_MINUTES=60
