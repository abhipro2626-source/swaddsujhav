# Copy to backend/.env  (this file is git-ignored; never ship it to the browser)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Lets the ML job read all orders and write recommendation tables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Paaji's studio voice (ElevenLabs). Leave empty to use the free browser voice.
# Lines are cached in backend/.cache/tts so each line is generated (and billed) once.
ELEVENLABS_API_KEY=
# A deep male voice ID from your ElevenLabs Voice Library (default: "Adam").
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional
PORT=8130
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRAIN_EVERY_MINUTES=60

# Paaji's brain: Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional backup voice: Azure Speech "Arjun" (free F0: https://portal.azure.com/#create/Microsoft.CognitiveServicesSpeechServices)
TTS_PROVIDER=edge
# Paaji's voice: Microsoft Madhur (free, unlimited, no key). Orus/George stay as backups.
EDGE_VOICE=hi-IN-MadhurNeural
# Paaji's voice: Gemini TTS (same free key). Owner's pick: Orus.
GEMINI_TTS_VOICE=Orus
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_VOICE=hi-IN-ArjunNeural
